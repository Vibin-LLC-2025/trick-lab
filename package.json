{
  "name": "trick-lab",
  "private": true,
  "version": "0.1.0",
  "description": "A browser 3D physics lab about rotation in projectile flight, taught through skateboard flip tricks.",
  "license": "MIT",
  "homepage": "https://vibin-llc-2025.github.io/trick-lab/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vibin-LLC-2025/trick-lab.git"
  },
  "bugs": {
    "url": "https://github.com/Vibin-LLC-2025/trick-lab/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "assets": "tsx scripts/build-board.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run assets:check && vite build && npm run bundle:check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "ktx-parse": "1.1.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
